# ── Backend .gitignore ────────────────────────────────────────────────────────

# Bağımlılıklar
node_modules/

# Derleme çıktıları
dist/

# Yüklenen kullanıcı avatarları (lokal geliştirme varsayılan UPLOAD_DIR).
# Canlıda kalıcı disk (Dokploy volume) kullanılır; bu klasör repoya girmez.
uploads/

# ── Ortam değişkeni dosyaları (asla commit edilmemeli) ───────────────────────
.env
.env.*
!.env.example       # Şablon — gerçek değer yok, commit edilebilir
!.env.*.example

# Loglar
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
*.pid
*.seed
*.pid.lock

# Test çıktıları
coverage/
.nyc_output/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Prisma — geliştirme SQLite (production PostgreSQL'i etkilemez)
prisma/migrations/dev.db
*.db
.env.backup-*

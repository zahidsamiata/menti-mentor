generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Çok-tenant izolasyonu: TenantId tüm tenant-scope tablolarda zorunludur.

enum UserRole {
  ADMIN
  MENTOR
  MENTI
}

enum DiscType {
  D
  I
  S
  C
}

enum VisibilityOptInStatus {
  PENDING
  APPROVED
  REJECTED
}

// Hangi tarafın opt-in sürecini başlattığını izler (Hibrit Akış denetimi)
enum OptInInitiator {
  MENTOR // Mentor-driven: mentor mentiyi sıralı listeden seçerek onayladı
  MENTI // Menti-driven: menti mentorun profiline görünürlük talebi gönderdi
}

enum MatchTargetType {
  USER
  JOB_LISTING
}

enum TimeCommitment {
  AYDA_1
  AYDA_2_3
  HAFTADA_1
  HAFTADA_2_PLUS
}

enum InteractionStyle {
  GOREV_BAZLI
  SOHBET_BAZLI
}

enum ExpectationCategory {
  KARIYER_YONLENDIRME
  TEKNIK_BECERI
  IS_STAJ_BAGLANTISI
  GIRISIMCILIK
  KISISEL_GELISIM
  SEKTOR_TANIMA
}

enum MeetingFormat {
  ONLINE
  IN_PERSON
  PHONE
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MeetingStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  APPROVED
  COMPLETED
  CANCELLED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum UserApprovalStatus {
  PENDING // Yeni kayıt — admin onayı bekleniyor
  APPROVED // Onaylandı — eşleşme havuzuna dahil
  REJECTED // Reddedildi — havuzdan çıkarıldı
}

enum ClubType {
  AKADEMIK
  SOSYAL
  SPOR
  SANAT
  TEKNOLOJI
  DIGER
}

enum ClubMemberRole {
  BASKAN
  YONETIM
  UYE
  DANISMAN
}

enum QuestionType {
  CORE      // Her yeni kullanıcıya gösterilen temel soru seti
  DEEPENING // Profil tamamlandıkça kilitlenen derinleştirici sorular
}

enum QuestionCategory {
  DISC_ASSESSMENT  // Karakter testi — DISC vektörüne katkı sağlar (kilitli, global)
  STK_CUSTOM       // STK'nın kendi amaçları için eklediği sorular (DISC'e katılmaz)
}

enum DiscDimension {
  D // Dominant — karar verme, liderlik
  I // Influential — iletişim, ikna
  S // Steady — sabır, güvenilirlik
  C // Conscientious — analiz, kalite
  GENERAL // Boyut-bağımsız genel profil sorusu
}

model Tenant {
  id                 String  @id @default(cuid())
  name               String
  slug               String  @unique
  isSharedPoolActive Boolean @default(false)
  tenantVocabulary   Json?

  // Kurumsal marka kimliği
  displayName  String? // Görüntü adı (ör. "Uluslararası Genç Derneği")
  logoUrl      String? // CDN veya relative URL
  primaryColor String? @default("#6366f1") // Tailwind indigo-500

  // PLG / Freemium katmanı
  plan            String  @default("FREE") // FREE | PRO | ENTERPRISE
  limits          Json? // {"max_reports": 3, "custom_domain": false, ...}
  onboardingStep  String  @default("PENDING") // PENDING | TEMPLATE | LOGO | PREVIEW | DONE
  programTemplate String? // "MEZUN" | "KULUP" | "GONULLU" | "OZEL"

  // Program kuralları — dernek yöneticisi kendi kurumunun dinamiklerine göre ayarlar
  maxMeetingsPerWeek     Int   @default(2) // Bir mentinin haftalık maks. görüşme sayısı
  minMatchScoreThreshold Int   @default(50) // Eşleşme taban barajı (0-100)
  blockedPairs           Json? // Array<{ fromUserId, toUserId, blockedAt, blockedBy }>

  // AlgorithmTuner bildirim sıklığı — admin kendi tercihine göre ayarlar
  // WEEKLY (varsayılan) | BIWEEKLY | MONTHLY
  reportingFrequency String @default("WEEKLY")

  // Super Admin askıya alma / aktif etme
  isActive Boolean @default(true)

  // Faz 3 — Taslak kurtarma e-postası (KVKK: unsubscribe zorunlu)
  // Token: selfServeRegister'da üretilir, e-postada unsubscribe linki olarak gider.
  // Yalnızca onboardingStep ['TEMPLATE','LOGO','PREVIEW'] tenant'larına gönderilir
  // (Step4 geçilmiş = e-posta+KVKK onayı alınmış).
  unsubscribeToken    String?   @unique  // crypto.randomUUID() — e-posta unsubscribe linki
  reminderEmailSentAt DateTime?          // Duplicate send koruması
  unsubscribedAt      DateTime?          // NULL = abone, set = listeden çıkmış

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  visibilityOptIns   VisibilityOptIn[]
  matchRequests      MatchRequest[]
  jobListings        JobListing[]
  feedbackLogs       FeedbackLog[]
  combinationScores  MatchCombinationScore[]
  meetings           Meeting[]
  feedbacks          Feedback[]
  clubs              Club[]
  clubMemberships    ClubMembership[]
  questions          Question[]
  questionHides      QuestionHide[]
  meetingCheckIns    MeetingCheckIn[]
  pendingTags        PendingTag[]
  memberships        TenantMembership[]
  availabilityBlocks AvailabilityBlock[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  role         UserRole
  email        String   @unique
  password     String? // OAuth kullanıcıları için null
  authProvider String   @default("LOCAL") // LOCAL | GOOGLE | LINKEDIN
  fullName     String
  isActive     Boolean  @default(true)

  sectorTags String[] @default([])

  discType        DiscType?
  temperamentJson Json?

  volunteerHistory Json?
  pastProjects     Json?
  education        Json?
  skills           String[] @default([])

  timeCommitment        TimeCommitment?
  expectationCategories ExpectationCategory[] @default([])
  interactionStyle      InteractionStyle?
  enneagramWing         String?
  rematchPriority       Boolean               @default(false)
  rematchCount          Int                   @default(0)

  bioSummary       String?
  expertiseDetails String?
  targetAudience   String?
  needsOrientation Boolean @default(false)

  // Onboarding onay durumu — yeni kayıtlar PENDING, admin onayı ile APPROVED olur
  approvalStatus UserApprovalStatus @default(PENDING)

  // DISC testi CORE aşamasını ilk tamamladığı an — admin bildirim tetikleyicisi için
  discAssessmentCompletedAt DateTime?

  // PLG: Mentör görünürlük tercihi — false yapınca menti tarafı bu mentörü göremez
  mentorVisibilityEnabled Boolean @default(true)
  // PLG: DISC testi sonrası üyeye gösterilen "Aha Anı" kartı verisi (arketip, süper güç vb.)
  discResultCard          Json?

  // Kesirli DISC vektörü: {D, I, S, C: 0-1 normalised, confidence: 0-1}
  discVector Json?

  // Serbest biçim metadata deposu — şema kısıtı yoktur.
  // Önerilen yapı: { personal, professional, tracking, customMetrics, certifications, ... }
  // Tüm alanlar isteğe bağlıdır; istemci istediği anahtarı ekleyebilir.
  selfProfile Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  pendingTags         PendingTag[]

  mentorOptIns VisibilityOptIn[] @relation("MentorOptIns")
  mentiOptIns  VisibilityOptIn[] @relation("MentiOptIns")

  requestsSent MatchRequest[] @relation("RequestsSent")

  feedbackLogs_as_mentor FeedbackLog[] @relation("FeedbackAsMentor")
  feedbackLogs_as_menti  FeedbackLog[] @relation("FeedbackAsMenti")

  meetingsAsMentor  Meeting[]  @relation("MeetingsAsMentor")
  meetingsAsMenti   Meeting[]  @relation("MeetingsAsMenti")
  feedbacksGiven    Feedback[] @relation("FeedbacksGiven")
  feedbacksReceived Feedback[] @relation("FeedbacksReceived")
  checkInsGiven     MeetingCheckIn[] @relation("CheckInsGiven")

  clubMemberships    ClubMembership[]
  responses          UserResponse[]
  userProfile        UserProfile?
  memberships        TenantMembership[]
  availabilityBlocks AvailabilityBlock[]
  mentorFilter       MentorFilter?

  // email @unique ile global unique; ayrıca tenant bazlı sorgular için index
  @@index([tenantId, role, isActive])
  // Auth: slug ile tenant bulunduktan sonra userId+tenantId sorgusu
  @@index([tenantId, id])
  // Analitik: DISC dağılım raporları için
  @@index([tenantId, discType])
  // Oryantasyon ihtiyacı olan kullanıcıları hızla bul
  @@index([tenantId, needsOrientation])
}

model VisibilityOptIn {
  id       String @id @default(cuid())
  tenantId String

  mentorId       String
  mentiId        String
  status         VisibilityOptInStatus @default(PENDING)
  initiatedBy    OptInInitiator        @default(MENTOR)
  iceBreaker     String?
  // Menti-driven akışta menti'nin mentora iletmek istediği kısa mesaj
  requestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor User   @relation("MentorOptIns", fields: [mentorId], references: [id])
  menti  User   @relation("MentiOptIns", fields: [mentiId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([mentorId, mentiId])
  @@index([tenantId])
  @@index([mentorId])
  @@index([mentiId])
  // Bekleyen opt-in sayısını hızla çek (dashboard)
  @@index([tenantId, status])
  // Mentor dashboard: kendi gelen menti talepleri
  @@index([mentorId, initiatedBy, status])
}

// Mentor'un kişisel eşleşme filtresi — UI'dan kaydettiği tercihler
model MentorFilter {
  id                    String     @id @default(cuid())
  mentorId              String     @unique
  minCompatibilityScore Int        @default(0)   // 0 = filtre yok, 1-100 arası eşik
  blockedDiscTypes      DiscType[] @default([])  // gösterilmeyecek DISC profilleri
  filterEnabled         Boolean    @default(true) // master toggle — false: filtre tamamen devre dışı
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  mentor User @relation(fields: [mentorId], references: [id])
}

model MatchRequest {
  id              String          @id @default(cuid())
  tenantId        String
  requesterUserId String
  targetType      MatchTargetType
  targetId        String
  requestMessage  String?         @db.VarChar(1000)
  createdAt       DateTime        @default(now())

  requester User   @relation("RequestsSent", fields: [requesterUserId], references: [id])
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([requesterUserId])
  @@index([targetType, targetId])
  // Job Board: belirli bir ilanı hedefleyen talepleri hızla bul
  @@index([tenantId, targetType, targetId])
}

model FeedbackLog {
  id       String @id @default(cuid())
  tenantId String
  mentorId String
  mentiId  String

  phase        Int
  starRating   Int
  difficulty   String?
  npsScore     Int?
  goalAchieved String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  mentor User   @relation("FeedbackAsMentor", fields: [mentorId], references: [id])
  menti  User   @relation("FeedbackAsMenti", fields: [mentiId], references: [id])

  @@unique([mentorId, mentiId, phase])
  @@index([tenantId])
  @@index([mentorId])
  @@index([mentiId])
}

model MatchCombinationScore {
  id              String   @id @default(cuid())
  tenantId        String
  discCombination String
  score           Float    @default(0)
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, discCombination])
  @@index([tenantId])
}

model Meeting {
  id               String        @id @default(cuid())
  tenantId         String
  matchId          String?
  mentorUserId     String
  mentiUserId      String
  startsAt         DateTime
  endsAt           DateTime
  status           MeetingStatus @default(PENDING)
  format           MeetingFormat @default(ONLINE)
  durationMin      Int           @default(60)
  notes            String?
  locationUrl      String?
  locationText     String?
  phoneNumber      String?
  hasFeedback      Boolean       @default(false)
  feedbackPrompted Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  match    Match?    @relation(fields: [matchId], references: [id])
  mentor   User      @relation("MeetingsAsMentor", fields: [mentorUserId], references: [id])
  menti    User      @relation("MeetingsAsMenti", fields: [mentiUserId], references: [id])
  feedback   Feedback?
  checkIns   MeetingCheckIn[]

  @@index([tenantId])
  @@index([mentorUserId])
  @@index([mentiUserId])
  @@index([matchId])
  @@index([tenantId, status])
  @@index([tenantId, startsAt])
  @@index([tenantId, status, hasFeedback])
}

// Görüşme sonrası kısa zorunlu değerlendirme (her iki taraf, ~45 saniye)
model MeetingCheckIn {
  id        String @id @default(cuid())
  meetingId String
  tenantId  String
  userId    String  // değerlendiren kullanıcı (mentor veya menti)
  role      UserRole // hangi rolden yaptığı

  // Katman 1 — Zorunlu (3-4 soru)
  overallRating      Int     // 1-5 yıldız: "Bu görüşme ne kadar değerliydi?"
  progressRating     Int     // 1-5: "Hedefe ne kadar yaklaştın?"
  continueIntent     String  // EVET | BELIRSIZ | HAYIR

  // Sadece mentör doldurur
  menteePreparedness Int?    // 1-5: "Menti hazırlıklı geldi mi?"

  // Katman 2 — Opsiyonel derin (isteğe bağlı)
  wantedMore         String? // YONLENDIRME | KAYNAK | BAGLANIT | GERI_BILDIRIM | HAYIR
  nextTopicNote      String? @db.VarChar(500) // "Bir sonraki görüşmede konuşmak istediğim:"
  concernTag         String? // mentör: MOT_DUSUK | HEDEF_BELIRSIZ | ZAMAN_YOK | ILETISIM | HAYIR
  continuationView   String? // KESINLIKLE | EVET | KARARSIZ | HAYIR
  openNote           String? @db.VarChar(1000) // serbest metin

  submittedAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    User    @relation("CheckInsGiven", fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([tenantId])
  @@index([meetingId])
  @@index([userId])
  @@index([tenantId, role, overallRating])
}

model Feedback {
  id        String @id @default(cuid())
  meetingId String @unique
  tenantId  String
  mentorId  String
  mentiId   String

  // Menti → Mentor
  guidanceScore        Int?  // Yönlendirme kalitesi (1-5)
  resourceSharingScore Int?  // Kaynak paylaşımı (1-5)
  trustScore           Int?  // Güven ve güvenlik hissi (1-5)

  // Mentor → Menti
  preparednessScore    Int?  // Hazırlık (1-5)
  proactivityScore     Int?  // Proaktiflik (1-5)
  engagementScore      Int?  // Katılım/motivasyon (1-5) — YENİ
  goalClarityScore     Int?  // Hedef netliği (1-5) — YENİ

  // Nitel — kısa
  keyLearnings         String? @db.VarChar(1000)
  specificComments     String? @db.VarChar(1000)

  // Dönemlik derin (opsiyonel, ayda bir tetiklenir)
  periodicCareerGrowth  String? @db.VarChar(2000) // "Bu ilişki kariyer gelişimine nasıl katkı sağladı?"
  periodicTrustScore    Int?    // 1-10
  periodicNetworkScore  Int?    // Ağ genişlemesi 1-5
  periodicConfidenceScore Int?  // Özgüven değişimi 1-5
  periodicNpsScore      Int?    // 0-10

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  mentor  User    @relation("FeedbacksGiven", fields: [mentorId], references: [id])
  menti   User    @relation("FeedbacksReceived", fields: [mentiId], references: [id])

  @@index([tenantId])
  @@index([mentorId])
  @@index([mentiId])
}

model JobListing {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String
  location    String?
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([isActive])
  // Tag tabanlı ilan araması için tenant + aktif filtresi
  @@index([tenantId, isActive])
}

// Merkezi sistem/hata logu — tenant bağımsız, admin erişimli
model SystemLog {
  id        String   @id @default(cuid())
  level     LogLevel
  category  String // EMAIL | ML | AUTH | DB | HTTP | SYSTEM
  message   String
  meta      Json? // hata stack, userId, tenantId vb.
  createdAt DateTime @default(now())

  @@index([level])
  @@index([category])
  @@index([createdAt])
  // Admin log dashboard'u: seviye + kategori + zaman filtresi
  @@index([level, category, createdAt])
}

// Üniversite kulübü ekosistemi
model Club {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        ClubType
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  memberships ClubMembership[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model ClubMembership {
  id       String         @id @default(cuid())
  tenantId String
  clubId   String
  userId   String
  role     ClubMemberRole @default(UYE)
  joinedAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([clubId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([clubId])
}

// Aşamalı profilleme soru bankası
// tenantId null → tüm tenant'larda geçerli global soru
model Question {
  id            String           @id @default(cuid())
  tenantId      String?          // null = global çekirdek soru (KILITLI — silinemez/değiştirilemez)
  text          String
  type          QuestionType     @default(CORE)
  discDimension DiscDimension    @default(GENERAL)
  category      QuestionCategory @default(DISC_ASSESSMENT) // DISC testi mi, STK özel mi?
  order         Int              @default(0)
  isActive      Boolean          @default(true)
  isRequired    Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant    Tenant?            @relation(fields: [tenantId], references: [id])
  responses UserResponse[]
  hiddenFor QuestionHide[]

  @@index([tenantId])
  @@index([type])
  @@index([discDimension])
  @@index([isActive])
}

// Tenant, global bir soruyu kendi kurumundan gizleyebilir (silmez — veri bütünlüğü korunur)
model QuestionHide {
  id         String   @id @default(cuid())
  questionId String
  tenantId   String
  hiddenAt   DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([questionId, tenantId])
  @@index([tenantId])
}

// Uzun süreli oturum yönetimi: 7 günlük refresh token
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * Kullanıcıların kayıt sırasında veya profil güncellemesinde önerdiği
 * henüz onaylanmamış etiketler. Admin paneli bu kuyruğu yönetir.
 * Onaylanınca (APPROVED) etiket tenant'ın globalTags havuzuna eklenir.
 * Birleştirilince (MERGED) kullanıcının sectorTags'i güncellenir.
 * Reddedilince (REJECTED) sessizce düşürülür — kullanıcıya bildirim yoktur.
 */
enum PendingTagStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

enum CertificationStatus {
  NOT_STARTED
  IN_PROGRESS
  CERTIFIED
  FAILED
  COOLDOWN
}

model PendingTag {
  id          String           @id @default(cuid())
  tenantId    String
  value       String // Kullanıcının girdiği ham etiket metni
  submittedBy String // userId
  status      PendingTagStatus @default(PENDING)
  /**
   * Birleştirme hedefi: mevcut havuzdaki etiket değeri
   */
  mergedInto  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [submittedBy], references: [id])

  @@unique([tenantId, value])
  @@index([tenantId, status])
  @@index([submittedBy])
}

// Tek kullanımlık şifre sıfırlama token'ı (SHA-256 hash olarak saklanır)
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Kullanıcının her soruya verdiği cevap (1–5 Likert)
model UserResponse {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  value      Int // 1=Hiç katılmıyorum … 5=Tamamen katılıyorum
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

// ─── SJT (Situational Judgement Test) Soru Havuzu ────────────────────────────

enum QuestionTier {
  CORE
  FOLLOWUP
}

enum AnswerFormat {
  SINGLE
  MOST_LEAST
}

// Senaryo bazlı soru bankası — OCEAN kalibrasyonu için.
// tenantId nullable: global sorular NULL, tenant-özel sorular tenantId içerir.
model SjtQuestion {
  id           String       @id @default(cuid())
  code         String       @unique
  tier         QuestionTier
  answerFormat AnswerFormat @default(SINGLE)
  forRole      UserRole
  scenario     String
  triggersOn   String? // OCEAN boyutu: o | c | e | a | n
  isActive     Boolean      @default(true)
  options      SjtOption[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tier, forRole, isActive])
}

// Soru seçenekleri — her seçeneğin OCEAN ağırlık haritası ve arketip sinyali.
model SjtOption {
  id               String      @id @default(cuid())
  questionId       String
  question         SjtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key              String
  label            String
  weights          Json // Partial<Record<"o"|"c"|"e"|"a"|"n", number>>
  signalsArchetype String?

  @@unique([questionId, key])
  @@index([questionId])
}

// ─── OCEAN / Arketip Profil Katmanı ─────────────────────────────────────────

enum MatchStatus {
  ACTIVE
  COMPLETED
  EARLY_EXIT
  DISSOLVED
}

enum Checkpoint {
  DAY_3
  DAY_14
  DAY_30
}

enum ProfileSource {
  DISC_DERIVED
  SJT_ENRICHED
  HYBRID
}

// DISC → OCEAN dönüşümü sonucu üretilen kullanıcı profili.
// Her User için en fazla bir UserProfile kaydı bulunur.
model UserProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  discD         Float         @default(0)
  discI         Float         @default(0)
  discS         Float         @default(0)
  discC         Float         @default(0)
  oceanO        Float?
  oceanC        Float?
  oceanE        Float?
  oceanA        Float?
  oceanN        Float?
  archetype     String?
  archetypeRole UserRole      @default(MENTI)
  profileSource ProfileSource @default(DISC_DERIVED)

  // ── Sektör Skoru (%60) için ek alanlar ──────────────────────────────────
  industryCode String? // IndustryNode.code — taksonomi ağaç konumu
  yearsExp     Int? // Mentor deneyim yılı (çan eğrisi bileşeni D)
  skillTags    String[] @default([]) // Beceri etiketleri (bileşen B)
  goalTags     String[] @default([]) // Hedef etiketleri (bileşen C, menti tarafında)
  schools      String[] @default([]) // Okul adları (bağlam bonusu E)
  companies    String[] @default([]) // Şirket adları (bağlam bonusu E)
  communities  String[] @default([]) // Topluluk / dernek adları (bağlam bonusu E)

  // ── Mentor Sertifikasyon Akademisi ───────────────────────────────────────
  isCertified         Boolean             @default(false)
  certificationStatus CertificationStatus @default(NOT_STARTED)
  certScore           Float?
  certifiedAt         DateTime?
  certAttempts        Int                 @default(0)
  cooldownUntil       DateTime?
  qualityMultiplier   Float               @default(1.0)

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorMatches Match[] @relation("MentorProfile")
  mentiMatches  Match[] @relation("MentiProfile")

  @@index([userId])
  @@index([archetype])
}

// Onaylanmış mentor-menti eşleşmesi — OCEAN arketip uyumu temelinde oluşturulur.
model Match {
  id              String      @id @default(cuid())
  mentorId        String
  mentiId         String
  predictedScore  Float
  sectorScore     Float
  characterScore  Float
  mentorArchetype String
  mentiArchetype  String
  status          MatchStatus @default(ACTIVE)
  tenantId        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  mentor    UserProfile     @relation("MentorProfile", fields: [mentorId], references: [id], onDelete: Cascade)
  menti     UserProfile     @relation("MentiProfile", fields: [mentiId], references: [id], onDelete: Cascade)
  feedbacks MatchFeedback[]
  meetings  Meeting[]

  @@unique([mentorId, mentiId])
  @@index([mentorId])
  @@index([mentiId])
  @@index([status])
  @@index([createdAt])
  @@index([mentorArchetype, mentiArchetype])
}

// ─── Sektör Taksonomi Ağacı ───────────────────────────────────────────────────
// Hiyerarşik sektör kodu ağacı — LCA tabanlı yakınlık skorlaması için.
// Ağaç kökleri parentId=null olan derinlik-1 düğümleridir.
model IndustryNode {
  id       String  @id @default(cuid())
  code     String  @unique // ör: "TEK.YZ.BE"
  label    String // ör: "Backend Geliştirme"
  depth    Int // 1=sektör, 2=alt-sektör, 3=yaprak
  parentId String?

  parent   IndustryNode?  @relation("TreeNodes", fields: [parentId], references: [id])
  children IndustryNode[] @relation("TreeNodes")

  @@index([parentId])
  @@index([depth])
}

// ─── Mentor Müsaitlik Blokları ────────────────────────────────────────────────
// Haftalık tekrar eden müsaitlik dilimleri (HH:MM string, tz-naive).
model AvailabilityBlock {
  id        String  @id @default(cuid())
  userId    String
  tenantId  String
  weekday   Weekday
  startTime String // "HH:MM" — örn. "14:00"
  endTime   String // "HH:MM" — örn. "16:00"
  timezone  String  @default("Europe/Istanbul")
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId, isActive])
  @@index([tenantId, weekday, isActive])
}

// ─── Multi-Tenant Üyelik Pivot Tablosu ───────────────────────────────────────
// Bir kullanıcının birden fazla tenant'ta farklı rollerde yer almasını sağlar.
// Sertifikasyon verileri UserProfile'dan bağımsız olarak üyelik bazında tutulur.
model TenantMembership {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  role                UserRole // ADMIN | MENTOR | MENTI
  isCertified         Boolean             @default(false)
  certificationStatus CertificationStatus @default(NOT_STARTED)
  certScore           Float?
  certifiedAt         DateTime?
  certAttempts        Int                 @default(0)
  cooldownUntil       DateTime?
  qualityMultiplier   Float               @default(1.0)
  isActive            Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, role, isActive])
  @@index([userId, isActive])
}

// ─── Mentor Sertifikasyon Akademisi Soru Bankası ─────────────────────────────
model CertificationQuestion {
  id        String                @id @default(cuid())
  code      String                @unique
  dimension String
  scenario  String
  isRedLine Boolean               @default(false)
  isActive  Boolean               @default(true)
  options   CertificationOption[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([isActive])
}

model CertificationOption {
  id              String                @id @default(cuid())
  questionId      String
  question        CertificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key             String
  label           String
  competencyScore Int

  @@unique([questionId, key])
  @@index([questionId])
}

// 3–14–30 gün kontrol noktalarında toplanan geri bildirimler.
model MatchFeedback {
  id            String     @id @default(cuid())
  matchId       String
  checkpoint    Checkpoint
  fromUserId    String
  role          UserRole
  progressScore Int?
  rapportScore  Int?
  earlyExit     Boolean    @default(false)
  comment       String?
  createdAt     DateTime   @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, checkpoint, fromUserId])
  @@index([matchId])
  @@index([checkpoint])
}

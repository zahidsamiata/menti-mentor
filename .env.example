DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menti_mentor?schema=public"

# Çok tenant'lı kullanım için örnek header: X-Tenant-Id
# Lokal geliştirmede basit test için bu değişkeni de kullanabilirsiniz:
DEFAULT_TENANT_ID=""

# LLM ice-breaker (sadece Visibility Opt-in sonrası kullanılacak)
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# E-posta bildirimleri (Gmail SMTP)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Menti-Mentor <your-email@gmail.com>"

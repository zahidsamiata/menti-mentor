DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menti_mentor?schema=public"

# ─── Çalışma modu ─────────────────────────────────────────────────────────────
# NODE_ENV: "production" DEĞİLSE 7 koruma birden sessizce kapanır — 3 fail-fast guard
#   (JWT_SECRET/PLATFORM_ADMIN_KEY/DEFAULT_TENANT_ID varsayılan reddi) + 4 cookie "secure"
#   bayrağı (platform admin çerezi dâhil). ⚠️ Canlıda MUTLAKA "production". Docker imajı bunu
#   set eder; yine de GET /health → "env" alanından teyit edin.
NODE_ENV="development"
# PORT: HTTP dinleme portu (varsayılan 3000). docker-compose zaten 3000 verir.
PORT="3000"

# Güvenlik
JWT_SECRET="min-32-karakter-guclu-secret-buraya"
# JWT_EXPIRES_IN: Access token ömrü (varsayılan "1h"). ⚠️ GÜVENLİK: uzatırsanız çalınan token
#   o kadar uzun geçerli kalır; kısaltmak güvenliği artırır, daha sık yenileme gerektirir.
JWT_EXPIRES_IN="1h"
PLATFORM_ADMIN_KEY="platform-admin-key-buraya"
# PLATFORM_ADMIN_EMAIL: /platform/login ekranındaki e-posta alanıdır (ikinci faktör).
# Set edilmezse tahmin edilebilir bir varsayılana düşer — canlıda mutlaka doldurun.
PLATFORM_ADMIN_EMAIL="platform-admin-eposta-buraya"
# Login brute-force koruması — IP başına dakikada azami giriş denemesi (varsayılan 10).
# Testte yüksek tutulur (.env.test'te 1000) ki meşru login akışları bozulmasın.
LOGIN_RATE_RPM="10"
# Şifre sıfırlama (forgot/reset) IP başına azami deneme/dk (varsayılan 5, login'den sıkı).
PASSWORD_RESET_RATE_RPM="5"
# ─── Diğer hız limitleri (IP veya kullanıcı bazlı, /dk) — hepsi rateLimiter.ts'te aktif ───
# ⚠️ GÜVENLİK: bunlar kötüye kullanım/brute-force/spam frenleridir. Düşürmek korumayı sıkar ama
#   meşru kullanıcıyı 429'a sokabilir; aşırı yükseltmek koruma penceresini açar.
# RATE_LIMIT_RPM: TÜM /api/* için genel limit — ⚠️ anahtar TENANT'tır, kurumun TÜM kullanıcıları
#   paylaşır (varsayılan 100). Büyük STK'da meşru kullanıcı 429 yiyebilir.
RATE_LIMIT_RPM="100"
PLATFORM_AUTH_RPM="10"            # Platform login brute-force (IP)
PLATFORM_READ_RPM="120"          # Platform panel okuma (IP)
AVATAR_UPLOAD_RPM="5"            # Avatar yükleme (kullanıcı)
REGISTER_RATE_RPM="10"           # Kayıt spam (IP)
SUSPICION_RATE_RPM="5"           # Şüphe bildirimi (IP)
INVITE_JOIN_RATE_RPM="20"        # Davet token deneme (IP) — NAT arkası toplu katılım için gevşek
CHECK_SLUG_RATE_RPM="30"         # Slug numaralandırma yavaşlatma (IP)
DATA_EXPORT_RATE_RPM="5"         # KVKK veri indirme (kullanıcı)
ACCOUNT_DELETE_RATE_RPM="5"      # Hesap kapatma (kullanıcı)
SELF_SERVE_REGISTER_RATE_RPM="5" # Sahte kurum başvurusu (IP)

# Lokal geliştirme — production'da kullanılmaz
DEFAULT_TENANT_ID=""

# ⚠️ ÖLÜ AYARLAR (2026-09-19 W denetimi §D.3/§7#24): LLM/ice-breaker yolu koddan KALDIRILDI
#   (iceBreaker.ts/matchReason.ts/llmRetry.ts silinmiş). Aşağıdaki 2 değişkenin kodda TÜKETİCİSİ
#   YOK → hiçbir etkisi yoktur. Buraya API anahtarı YAZMAYIN (boşuna sır ifşası). Kaldırılmaları
#   SİLME PROTOKOLÜ gereği PO kararına bağlı (KARAR "LLM/OpenAI ölü env"). Aynı sebeple ölü olan
#   LLM_PROVIDER bu şablona EKLENMEDİ.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# E-posta bildirimleri — Generic SMTP relay (öneri: Resend; alternatif: Brevo)
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
# Brevo : SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<SMTP key>
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="your-provider-api-key"
# Gönderen: SPF/DKIM doğrulanmış kurumsal domain. SMTP_FROM zorunlu.
SMTP_FROM="noreply@sivilkapasite.org"
# SMTP_SECURE opsiyonel — 465 için otomatik true, 587 için false. Override: "true"/"false".
# SMTP_SECURE="true"
# TENANT_NOTIFICATIONS_ENABLED: Kurum (STK) başvuru onay/ret/düzeltme e-postası ana şalteri.
#   ⚠️ Varsayılan KAPALI ("true" değilse kapalı). Kapalıyken bu mailler HİÇ gitmez, yalnız log
#   yazılır → başvuru sahibi kurum süresiz askıda kalır. Canlıda "true" yapılmalı (bkz. 03-PO).
TENANT_NOTIFICATIONS_ENABLED="false"

# ─── Zamanlanmış işler + önbellek ─────────────────────────────────────────────
# CRON_ENABLED: Zamanlanmış işlerin ana şalteri (varsayılan AÇIK; yalnız "false" kapatır).
#   ⚠️ "false" yazılırsa 8 iş durur: KVKK 90 gün/3 yıl imhası (SAKLAMA İHLALİ), anlaşma yenileme,
#   geri bildirim hatırlatması vb. Kapatmayın; teyit için log'da "[CRON] Haftalık görevler…" satırı.
CRON_ENABLED="true"
# TENANT_CACHE_TTL_MS: Tenant L1 önbellek ömrü (varsayılan 300000 = 5 dk). Kurum ayarı (logo,
#   paylaşımlı havuz, sözlük) değişikliği invalidate edilmeyen yollarda bu süreye kadar gecikebilir.
TENANT_CACHE_TTL_MS="300000"

# URL yapılandırması
# FRONTEND_URL: React/Next.js uygulamasının base URL'i (şifre sıfırlama, onboarding linkleri)
FRONTEND_URL="http://localhost:3001"
# BACKEND_URL: Express API'nin base URL'i (e-posta unsubscribe linki gibi backend route'ları için)
# Tek-domain deploy'da FRONTEND_URL ile aynı bırakılabilir (ör. nginx proxy arkasında).
# Ayrı-domain deploy'da API'nin URL'ini girin (ör. "https://api.menti-mentor.com").
BACKEND_URL="http://localhost:3000"
# CORS izin verilen kaynak listesi — virgülle ayrılmış. Canlıda frontend domain'ini girin.
# Örnek: ALLOWED_ORIGINS="https://yourapp.vercel.app"
ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
FRONTEND_OAUTH_CALLBACK_URL="http://localhost:3001/oauth/callback"

# ⚠️ ÖLÜ AYAR (2026-09-19 W §9.3/§7#24, X §9.3): config.ts:100'de okunuyor ama TÜKETİCİSİ YOK.
#   Davet token'ı gerçekte selfServeController.ts:571/632'de SABİT "30d" ile imzalanır — bu değeri
#   değiştirmek hiçbir şeyi değiştirmez. Ekranlardaki "90 gün" ifadesi de yanlış (bkz. U-11).
#   Kaldırılması/canlandırılması ürün kararına bağlı.
INVITATION_TOKEN_EXPIRY="90d"

# ─── Avatar yükleme (kullanıcı profil fotoğrafı) ──────────────────────────────
# UPLOAD_DIR: Yüklenen fotoğrafların yazıldığı klasör. Deploy'da SİLİNMEMESİ için
#   KALICI DİSK (Dokploy persistent volume) olarak mount edilmeli. Örn. canlıda "/app/uploads".
#   Boş bırakılırsa lokalde backend/uploads kullanılır (git'e girmez).
UPLOAD_DIR=""
# UPLOAD_PUBLIC_BASE_URL: Yüklenen dosyanın erişileceği URL tabanı (avatarUrl bununla üretilir).
#   Boş bırakılırsa BACKEND_URL kullanılır. Ayrı statik/CDN host varsa burada verin.
#   Örn: "https://api.sivilkapasite.org"
UPLOAD_PUBLIC_BASE_URL=""
# UPLOAD_MAX_BYTES: Azami dosya boyutu (byte). Varsayılan 5MB (5242880).
UPLOAD_MAX_BYTES="5242880"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Adımlar: console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ─── LinkedIn OAuth ───────────────────────────────────────────────────────────
# Adımlar: developer.linkedin.com → Apps → Auth → OAuth 2.0 settings
# Authorized redirect URL: http://localhost:3000/api/auth/linkedin/callback
# Gerekli ürünler: "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"
